# WildBridge MediaMTX relay (compose.mediamtx.yaml)
# Space/comma/semicolon-separated list of drone IPs to trigger + alias by IP.
DRONE_IPS=192.168.0.116

# Optional overrides (defaults shown) — uncomment to change:
# TELEMETRY_PORT=8081               # phone telemetry port (triggers publishing)
# HTTP_PORT=8080                    # phone HTTP port (drone-name discovery)
# MEDIAMTX_WEBRTC_UDP_ADDRESS=:8189 # WebRTC ICE/UDP address
